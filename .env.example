# Local Compose replica set. Production uses authenticated replica-set/Atlas URIs.
MONGO_URI_USERS=mongodb://mongo:27017/ecommerce-users?replicaSet=rs0
MONGO_URI_PRODUCTS=mongodb://mongo:27017/ecommerce-products?replicaSet=rs0
MONGO_URI_CART=mongodb://mongo:27017/ecommerce-cart?replicaSet=rs0
MONGO_URI_ORDER=mongodb://mongo:27017/ecommerce-order?replicaSet=rs0
MONGO_URI_PAYMENT=mongodb://mongo:27017/ecommerce-payment?replicaSet=rs0

# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SERVICE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
IMAGE_PREFIX=ecommerce
IMAGE_TAG=local
